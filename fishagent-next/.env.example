FISHAGENT_HOST=0.0.0.0
FISHAGENT_PORT=3008

# PostgreSQL is the durable source of truth when configured. Leave empty for
# the in-memory unit-test fallback.
FISHAGENT_DATABASE_URL=postgresql://fishagent:fishagent@127.0.0.1:5432/fishagent
FISHAGENT_REDIS_URL=redis://127.0.0.1:6379/0
FISHAGENT_MINIO_ENDPOINT=http://127.0.0.1:9000
FISHAGENT_MINIO_ACCESS_KEY=fishagent
FISHAGENT_MINIO_SECRET_KEY=fishagent-secret

# Set this to true outside local demo mode. The password is never persisted in
# the database or returned by an API.
FISHAGENT_AUTH_ENABLED=false
FISHAGENT_ADMIN_USERNAME=admin
FISHAGENT_ADMIN_PASSWORD=

# OpenAI-compatible / Z.ai compatible model API settings.
FISHAGENT_LLM_PROVIDER=zai
FISHAGENT_LLM_BASE_URL=https://api.z.ai/api/paas/v4
FISHAGENT_LLM_MODEL=glm-4.5
FISHAGENT_LLM_API_KEY=
FISHAGENT_LLM_ENABLED=false
