FISHAGENT_HOST=0.0.0.0
FISHAGENT_PORT=3000
FISHAGENT_AGENT_DECISION_TIMEOUT_SECONDS=300
FISHAGENT_PUBLIC_PORT=3001

# PostgreSQL is the durable source of truth when configured. Leave empty for
# the in-memory unit-test fallback.
FISHAGENT_DATABASE_URL=postgresql://fishagent:fishagent@127.0.0.1:5432/fishagent
FISHAGENT_REDIS_URL=redis://127.0.0.1:6379/0
FISHAGENT_MINIO_ENDPOINT=http://127.0.0.1:9000
FISHAGENT_MINIO_ACCESS_KEY=fishagent
FISHAGENT_MINIO_SECRET_KEY=fishagent-secret
FISHAGENT_MINIO_BUCKET=fishagent-evidence

# Web/worker boundary. The web process is served by FastAPI/Uvicorn; Celery
# worker and beat are enabled in Compose and can be disabled for unit tests.
FISHAGENT_CELERY_ENABLED=false
FISHAGENT_CELERY_BROKER_URL=redis://127.0.0.1:6379/1
FISHAGENT_CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# Optional MQTT telemetry adapter.
FISHAGENT_MQTT_ENABLED=true
FISHAGENT_MQTT_HOST=127.0.0.1
FISHAGENT_MQTT_PORT=1883
FISHAGENT_MQTT_TOPIC=farms/+/ponds/+/sensors/+
FISHAGENT_MQTT_COMMAND_TOPIC=fishagent/ponds/{pond_id}/devices/{device_id}/commands

# Set this to true outside local demo mode. The password is never persisted in
# the database or returned by an API.
FISHAGENT_AUTH_ENABLED=false
FISHAGENT_ADMIN_USERNAME=admin
FISHAGENT_ADMIN_PASSWORD=
FISHAGENT_USERS_JSON={}
FISHAGENT_AUTH_COOKIE_SECURE=false

# OpenRouter is OpenAI-compatible. Replace only the placeholder key; the
# application appends /chat/completions to this base URL.
FISHAGENT_LLM_PROVIDER=openrouter
FISHAGENT_LLM_BASE_URL=https://openrouter.ai/api/v1
FISHAGENT_LLM_MODEL=openrouter/free
FISHAGENT_LLM_API_KEY=sk-or-v1-REPLACE_WITH_YOUR_KEY
FISHAGENT_LLM_ENABLED=false
